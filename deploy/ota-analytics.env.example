# Copy to /etc/ota-analytics.env, fill in, then lock it down:
#
#   sudo cp deploy/ota-analytics.env.example /etc/ota-analytics.env
#   sudo chown root:root /etc/ota-analytics.env && sudo chmod 600 /etc/ota-analytics.env
#
# This file holds the real platform password and the dashboard password verifiers. It is the
# one secret on the box. Never commit it, never copy it into the repo directory.

# ─── dashboard access ────────────────────────────────────────────────────────
# Generate each with:  .venv/bin/python -m ota_analytics.cli passwd --role admin
# It prompts, so the password never lands in shell history or in `ps` output.
OTA_ADMIN_PASSWORD_HASH=
# Optional. The read-only account: sees every page, refused on every POST.
OTA_VIEWER_PASSWORD_HASH=

# Signs session cookies. Generate once with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs everyone out, which is also how you revoke every session at once.
OTA_SECRET_KEY=

# Set to 1 only when the app sits behind Cloudflare Access (or equivalent) that has already
# authenticated the user. It makes the app trust an identity header — which anything able to
# reach the port could forge, so it is safe only because the port is loopback-only.
OTA_TRUST_PROXY_AUTH=0

# ─── platform credentials ────────────────────────────────────────────────────
# The account the scheduler uses to fetch exports. `keyring` has no backend on a headless
# server, so this variable is how the secret gets in; without it the service starts and
# silently never fetches anything again.
OTA_PLATFORM_PASSWORD=

# ─── paths ───────────────────────────────────────────────────────────────────
# Must match the unit's ReadWritePaths. Keeping downloads under data/ means the application
# directory itself can stay read-only.
OTA_DATA_DIR=/opt/ota-analytics/data
OTA_EXPORT_DIR=/opt/ota-analytics/data/exports
OTA_REPORT_DIR=/opt/ota-analytics/reports
