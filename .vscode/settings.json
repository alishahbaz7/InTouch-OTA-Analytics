{
  // ONE environment for the whole project. Four Pythons are installed on this machine
  // (3.12, 3.13, 3.14, and a WindowsApps shim); packages installed into one are invisible to
  // the others, which is how "jinja2 must be installed" happened while pip insisted it was.
  // The project venv removes the question entirely — F5, the terminal and the test runner all
  // resolve to the same interpreter, and it travels with the repo.
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  }
}
